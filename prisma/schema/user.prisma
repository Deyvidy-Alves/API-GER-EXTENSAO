model User {
  id                      String   @id @default(uuid())
  nome                    String
  nomeUsual               String? //nome de exibição no sistema
  email                   String   @unique
  emailSiape              String?  @unique
  emailRecuperacao        String?
  emailNotificacao        String?
  emailGoogleSalaAula     String?
  telefonesInstitucionais String? // JSON string: '["(88)99999-9999"]'
  telefonesPessoais       String? // JSON string: '["(88)99999-9999"]'
  senhaHash               String
  emPGD                   Boolean  @default(false)
  ativo                   Boolean  @default(true)
  createdAt               DateTime @default(now())

  // DADOS PESSOAIS COMUNS
  cpf                String?         @unique
  dataNascimento     DateTime?
  sexo               Sexo?
  naturalidade       String?
  racaEtnia          CorRaca?
  nomeSocial         String?
  estadoCivil        EstadoCivil?
  grupoSanguineo     GrupoSanguineo?
  quantDependentesIR Int?
  nomePai            String?
  nomeMae            String?
  pisPasep           String?         @unique
  escolaridade       String?

  // RG COMUM
  rgNumero         String?
  rgOrgaoExpeditor String?
  rgUf             String?
  rgDataExpedicao  DateTime?

  // TITULO DE ELEITOR
  tituloNumero String?
  tituloZona   String?
  tituloSecao  String?
  tituloUf     String?

  // ENDERECO COMUM
  endereco    String?
  numero      String?
  bairro      String?
  complemento String?
  cep         String?
  cidade      String?

  // RELACOES
  instituicaoId String
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])

  perfilAluno    PerfilAluno?
  perfilServidor PerfilServidor?

  papeis     UserPapel[]
  relatorios Relatorio[]

  @@map("users")
}
