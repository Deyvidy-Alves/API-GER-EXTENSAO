//essa tabela vai registrar os relatorios gerados. Funciona como um recebio/comprovante.
model Relatorio {
  id         String   @id @default(uuid())
  tipo       String //ex "alunos_ativos", "inscricoes_por_curso"
  parametros Json?
  arquivoUrl String?
  geradoEm   DateTime @default(now())

  geradoPorId String
  geradoPor   User   @relation(fields: [geradoPorId], references: [id])

  @@map("relatorios")
}
