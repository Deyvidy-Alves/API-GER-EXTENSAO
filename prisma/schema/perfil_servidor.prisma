model PerfilServidor {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Dados funcionais comuns a qualquer servidor
  siape                      String            @unique
  matricula                  String?           @unique
  setorSuap                  String?
  lotacaoSiape               String?
  exercicioSiape             String?
  situacao                   SituacaoServidor?
  regimeTrabalho             RegimeTrabalho?
  jornadaTrabalho            JornadaTrabalho?
  operaRaioX                 Boolean           @default(false)
  inicioServicoPublico      DateTime?
  dataPosseInstituicao       DateTime?
  inicioExercicioInstituicao DateTime?
  dataPosseCargo             DateTime?
  inicioExercicioCargo       DateTime?
  cargo                      String?
  classeCargo                String?
  padrao                     String?
  grupoCargo                 String?
  codigoVaga                 String?

  // Dados bancários comuns
  banco         String?
  agencia       String?
  contaCorrente String?

  // Relação com perfil específico
  perfilProfessor PerfilProfessor?

  @@map("perfis_servidor")
}
