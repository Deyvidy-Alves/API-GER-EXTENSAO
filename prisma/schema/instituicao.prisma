model Instituicao {
  id        String   @id @default(uuid())
  nome      String
  sigla     String   @unique
  endereco  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios User[]

  cursos CursoExtensao[]

  departamentos Departamento[]

  @@map("instituicoes")
}
