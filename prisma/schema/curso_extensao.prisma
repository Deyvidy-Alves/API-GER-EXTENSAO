model CursoExtensao {
  id                    String                 @id @default(uuid())
  titulo                String
  cargaHoraria          Int
  dataInicio            DateTime
  dataFim               DateTime
  status                StatusCurso            @default(RASCUNHO)
  createdAt             DateTime               @default(now())
  professorId           String
  instituicaoId         String
  tipo                  TipoCurso              @default(FORMACAO_CONTINUADA)
  apresentacao          String                 @db.Text
  areaTematica          String
  fomento               String?
  justificativa         String                 @db.Text
  linhaExtensao         String
  localAtuacao          LocalAtuacao
  maxBeneficiados       Int
  metodologia           String                 @db.Text
  minBeneficiados       Int
  modeloOferta          ModeloOferta
  objetivoGeral         String                 @db.Text
  objetivosEspecificos  String                 @db.Text
  programaInstitucional String?
  publicoAlvo           String                 @db.Text
  tipoAcao              TipoAcao
  imagemCapa            String?
  atividades            CursoAtividade[]
  instituicao           Instituicao            @relation(fields: [instituicaoId], references: [id])
  professor             PerfilProfessor        @relation(fields: [professorId], references: [id])
  formasAvaliacao       CursoFormaAvaliacao[]
  formasDivulgacao      CursoFormaDivulgacao[]
  municipios            CursoMunicipio[]
  inscricoes            Inscricao[]
  orcamentos            ItemOrcamento[]
  equipes               MembroEquipe[]
  parcerias             Parceria[]

  @@index([instituicaoId], map: "cursos_extensao_instituicaoId_fkey")
  @@index([professorId], map: "cursos_extensao_professorId_fkey")
  @@map("cursos_extensao")
}
