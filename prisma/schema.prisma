// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


enum StatusCurso {
  RASCUNHO
  PUBLICADO
  EM_ANDAMENTO
  ENCERRADO
  CANCELADO
}

enum StatusInscricao {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  LISTA_ESPERA
}

enum TipoCurso {
  FORMACAO_INICIAL //a partir de 160h
  FORMACAO_CONTINUADA //mínimo de 40h
}

enum Sexo {
  MASCULINO
  FEMININO
}

enum CorRaca {
  AMARELA
  BRANCA
  PARDA
  INDIGENA
  NAO_DECLARADA
}

enum RendaFamiliarPerCapita {
  ATE_MEIO_SM
  MEIO_A_UM_SM
  UM_A_UM_E_MEIO_SM
  UM_E_MEIO_A_DOIS_SM
  DOIS_E_MEIO_A_TRES_SM
  ACIMA_DE_TRES_SM
}

model Instituicao {
  id String @id @default(uuid())
  nome String
  sigla String @unique
  endereco String?
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  
  usuarios User[]
  
  cursos CursoExtensao[]

  @@map("instituicoes")

}

model User {
  id String @id @default(uuid())
  nome String
  email String @unique
  senhaHash String
  ativo Boolean @default(true)
  createdAt DateTime @default(now())

  instituicaoId String
  instituicao Instituicao @relation(fields: [instituicaoId], references: [id])

  perfilAluno PerfilAluno?
  perfilProfessor PerfilProfessor?

  papeis UserPapel[]
  relatorios Relatorio[]

  @@map("users")
}

model Papel {
  id String @id @default(uuid())
  nome String @unique //ex: "ADMIN", "professor", "deppi"

  permissoes PapelPermissao[] //uma permissao pode pertencer a varios papeis
  usuarios UserPapel[] //um papel pode ter uma lista de usuarios

  @@map("papeis")
}

model UserPapel {
  userId String
  user User @relation(fields: [userId], references: [id])

  papelId String
  papel Papel @relation(fields: [papelId], references: [id])

  @@id([userId, papelId])
  @@map("users_papeis")
}

model Permissao {
  id String @id @default(uuid())
  recurso String //ex: "cursos", "professores", "inscrições"
  acao String //ex: "create", "delete", "update", "delete"

   papeis PapelPermissao[]

  @@unique([recurso, acao]) // nao se pode repetir um registro userId+recurso+acao
  @@map("permissoes")
}

model PapelPermissao {
  papelId String 
  papel Papel @relation(fields: [papelId], references: [id])
  atribuidoEm DateTime @default(now())

  permissaoId String
  permissao Permissao @relation(fields: [permissaoId], references: [id])

  @@id([papelId, permissaoId])
  @@map("papeis_permissoes")
}

model PerfilAluno {
  id String @id @default(uuid())
  matricula String @unique
  cursoGraduacao String
  semestre Int?

  //DADOS PESSOAIS
  nomeSocial String?
  dataNascimento DateTime?
  sexo Sexo?
  naturalidade String?
  corRaca CorRaca?

  //ENDERECO
  endereco String?
  numero String?
  bairro String?
  complemento String?
  cep String?
  cidade String?

  //CONTATO E FORMACAO
  grauInstrucao String?
  profissao String?
  telefoneComercial String?
  telefoneCelular String?

  //DOCUMENTACAO
  cpf String? @unique
  rg String? @unique
  rgOrgaoEmissor String?
  rgUf String?
  rgDataEmissao DateTime?

  //SOCIALECONOMICO
  rendaFamiliarPerCapita RendaFamiliarPerCapita?
  numPessoasFamilia Int?
  
  userId String @unique
  user User @relation(fields: [userId], references: [id])

  inscricoes Inscricao[]

  @@map("perfis_alunos")
}

model PerfilProfessor {
  id String @id @default(uuid())
  siape String @unique
  titulacao String?
  departamento String?

  userId String @unique
  user User @relation(fields: [userId], references: [id])

  cursos CursoExtensao[]

  @@map("perfis_professor")
}

model CursoExtensao {
  id String @id @default(uuid())
  titulo String
  descricao String @db.Text
  cargaHoraria Int
  tipo TipoCurso @default(FORMACAO_CONTINUADA)
  vagas Int
  dataInicio DateTime
  dataFim DateTime
  status StatusCurso @default(RASCUNHO)
  createdAt DateTime @default(now())
  
  professorId String 
  professor PerfilProfessor @relation(fields: [professorId], references: [id])

  instituicaoId String
  instituicao Instituicao @relation(fields: [instituicaoId], references: [id])

  inscricoes Inscricao[]


  @@map("cursos_extensao")
}

//resultante da relação N:N entre perfis_alunos e cursos_extensao
model Inscricao {
  id String @id @default(uuid())
  status StatusInscricao @default(PENDENTE)
  inscricaoEm DateTime @default(now())
  updateAt DateTime @updatedAt

  alunoId String
  aluno PerfilAluno @relation(fields: [alunoId], references: [id])

  cursoId String
  curso CursoExtensao @relation(fields: [cursoId], references: [id])

  @@unique([alunoId, cursoId])
  @@map("inscricoes")
}


//essa tabela vai registrar os relatorios gerados. Funciona como um recebio/comprovante.
model Relatorio {
  id String @id @default(uuid())
  tipo String //ex "alunos_ativos", "inscricoes_por_curso"
  parametros Json?
  arquivoUrl String?
  geradoEm DateTime @default(now())

  geradoPorId String
  geradoPor User @relation(fields: [geradoPorId], references: [id])

  @@map("relatorios")
}