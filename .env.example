# Banco de dados
DATABASE_URL="mysql://usuario:senha@localhost:3307/api-ger-extensao"
DATABASE_USER="usuario"
DATABASE_PASSWORD="senha"
DATABASE_NAME="api-ger-extensao"
DATABASE_HOST="localhost"
DATABASE_PORT=3307
# Defina como true para conexoes gerenciadas na nuvem que exigem SSL/TLS.
DATABASE_SSL=false

# Servidor
PORT=3000
NODE_ENV=development

# Autenticacao
JWT_SECRET="defina-um-segredo-forte-aqui"
JWT_EXPIRES_IN="7d"

# ADMIN inicial (bootstrap) criado pelo seed (npx prisma db seed).
ADMIN_EMAIL="admin@ifce.edu.br"
ADMIN_PASSWORD="troque-esta-senha"

# CORS: origens liberadas separadas por virgula (ex: https://app.com,https://admin.app.com).
# Deixe vazio para liberar todas as origens (apenas em desenvolvimento).
CORS_ORIGINS=
